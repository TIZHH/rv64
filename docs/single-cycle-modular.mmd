%% Port convention: *_i = input, *_o = output.
%% decoder / alu / regfile are shared with the legacy and pipeline builds
%% and keep their original port names.
flowchart LR
    CLK([clk_i]) -.-> PC[pc_register]
    RESET([reset_i]) -.-> PC

    IM[instruction_memory\naddress_i / instruction_o\n256 x 32-bit\n$readmemh instruction.hex]
    DM[data_memory\naddress_i / read_data_o\nwrite_data_i / write_mask_i\n4096 byte\n$readmemh data.hex]

    DEC[decoder\nshared module]
    RF[regfile\nshared module\nx0 hardwired zero]
    ALU[alu\nshared module]
    BR[branch_unit\nbranch_type_i / taken_o]
    NPC[next_pc_logic\npc_i / next_pc_o]
    MA[memory_access\nports *_i / *_o]
    WB[writeback_mux\nwriteback_data_o]

    PC -- "pc_o[63:0]" --> IM
    IM -- "instruction_o[31:0]" --> DEC
    DEC -- "rs1/rs2/rd fields" --> RF
    RF -- "register_a[63:0]" --> ALU
    RF -- "register_b[63:0]" --> ALU
    DEC -- "alu_src_imm" --> ALU
    DEC -- "immediate[63:0]" --> ALU
    DEC -- "alu_operation[4:0]" --> ALU
    ALU -- "alu_result[63:0]" --> MA
    ALU -- "alu_result[63:0]" --> WB

    RF -- "register_a, register_b" --> BR
    DEC -- "branch_type[2:0]" --> BR
    BR -- "taken_o" --> NPC
    PC -- "pc_o[63:0]" --> NPC
    DEC -- "immediate, branch, jump, jump_register" --> NPC
    RF -- "register_a_i[63:0]" --> NPC
    NPC -- "next_pc_o[63:0]" --> PC

    DEC -- "mem_read, mem_write, memory_size, unsigned" --> MA
    RF -- "store_value_i[63:0]" --> MA
    MA -- "read_enable_o, data_address_o" --> DM
    MA -- "write_enable_o, write_data_o, write_mask_o" --> DM
    DM -- "read_data_o[63:0]" --> MA
    MA -- "load_value_o[63:0]" --> WB

    DEC -- "writeback_source[2:0]" --> WB
    PC -- "pc_o[63:0]" --> WB
    DEC -- "immediate[63:0]" --> WB
    WB -- "writeback_data_o[63:0]" --> RF
    DEC -- "reg_write & valid" --> RF

    PC -. "pc_o" .-> OUT[debug_x10_o / debug_x31_o\nillegal_instruction_o\ndebug_memory_word_o]
    RF -. "debug_x10, debug_x31" .-> OUT
    DEC -. "valid -> illegal_instruction_o" .-> OUT
    DM -. "debug_word_o" .-> OUT

    classDef state fill:#e9f8f0,stroke:#18865b,stroke-width:2px;
    classDef memory fill:#eef6ff,stroke:#5b8fd8,stroke-width:2px;
    classDef control fill:#fff5e8,stroke:#d56b1f,stroke-width:2px;
    class PC,NPC state;
    class IM,DM memory;
    class DEC,BR,MA,WB control;
